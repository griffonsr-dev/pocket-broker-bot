APP_ENV=demo
LOG_LEVEL=INFO
BROKER_MODE=unofficial_sdk
MASTER_API_TOKEN=replace-with-your-strong-token
POSITION_POLL_INTERVAL_SECONDS=0.5

# Demo/live settings are selected by APP_ENV.
# For live use, copy this file to .env.live and fill in the real values.
# For demo use, copy this file to .env.demo and keep demo credentials only.

# Master account
# MASTER_BROKER_ACCOUNT_ID=your-master-broker-id
# MASTER_CREDENTIAL_REF=PO_MASTER_CREDENTIALS

# Child 1
# CHILD_ACCOUNT_NAME=Tony
# CHILD_BROKER_ACCOUNT_ID=your-child-1-broker-id
# CHILD_CREDENTIAL_REF=PO_CHILD_1_CREDENTIALS

# Child 2
# CHILD_2_ACCOUNT_NAME=Margaret
# CHILD_2_BROKER_ACCOUNT_ID=your-child-2-broker-id
# CHILD_2_CREDENTIAL_REF=PO_CHILD_2_CREDENTIALS

# Credentials loaded by ref
# PO_MASTER_CREDENTIALS=...
# PO_CHILD_1_CREDENTIALS=...
# PO_CHILD_2_CREDENTIALS=...
